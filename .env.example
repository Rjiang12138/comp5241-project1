# ---------------------------------------------------------------------------
# Praxis — environment variables
# Copy to .env.local and fill in. DATABASE_URL is required: the app reads and
# writes Postgres on Neon. `neon deploy` writes both database variables for you.
# ---------------------------------------------------------------------------

# Postgres on Neon. Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (unpooled) endpoint. `prisma db push` and migrations need it, because
# PgBouncer in transaction mode cannot run DDL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Session cookie signing key. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# LLM providers for the generation pipeline (lib/llm.ts).
#
# Two providers in a fixed order: ChatAnywhere first, OpenRouter as the spare.
# A call only reaches the spare when the primary declined — no key, 429, bad
# key, empty reply. With neither key set the studio still works: generation
# falls back to the built-in template and the screen says so.
#
# Both keys are free tiers, so calls are serialised and spaced by
# LLM_MIN_GAP_MS. Raising that number is the first thing to try if a 429 shows
# up in the generation log.
CHATANYWHERE_API_KEY=""
CHATANYWHERE_BASE_URL="https://api.chatanywhere.tech/v1"
CHATANYWHERE_MODEL="gpt-4o-mini"
LLM_MIN_GAP_MS="4000"

OPENROUTER_API_KEY=""
# Optional: pin one model instead of the free chain, e.g.
# OPENROUTER_MODEL="poolside/laguna-s-2.1:free"
OPENROUTER_MODEL=""

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Public base URL, used for absolute links in emails and the sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
